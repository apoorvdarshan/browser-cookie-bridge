{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "browser-cookie-bridge-web",
  "compatibility_date": "2026-08-10",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    {
      "pattern": "cookiebridge.apoorvdarshan.com",
      "custom_domain": true
    }
  ],
  "send_metrics": false
}
